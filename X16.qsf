# MJoergen 65c02 (rtl/cpu/mj65c02, MIT) -- the OSD-selectable 65C02.
# Ported off ieee.numeric_std_unsigned to std_logic_unsigned/conv_integer
# (Quartus Standard's ieee library lacks the 2008 package -> Error 10481);
# fmt.vhd/debug.vhd (sim-only tracing, heavy 2008 library use) are excised
# from the vendored core and not listed here.  All remaining files are
# VHDL-93-clean (out-port reads + port-map expressions rewritten via
# internal signals) -- NO -hdl_version needed: Quartus Standard's "2008"
# front end is partial (rejects out-port reads, Error 10577/10600), so the
# only safe target is plain 93.  The core lives in its own
# library `mj65c02` -- its entity
# names clash case-insensitively with the P65C816's in work (alu = ALU,
# Quartus 10430); internal `entity work.x` refs resolve to the compilation
# library, so the core sources need no edits.  Only the wrapper is in work
# (x16.sv instantiates it); it references mj65c02.cpu_65c02.
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/alu.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/ar.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/hi.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/lo.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/mr.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/pc.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/sp.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/sr.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/xr.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/yr.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/zp.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/datapath/datapath.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/control/microcode_6502.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/control/microcode_65c02.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/control/control.vhd -library mj65c02
set_global_assignment -name VHDL_FILE rtl/cpu/mj65c02/cpu_65c02.vhd -library mj65c02
