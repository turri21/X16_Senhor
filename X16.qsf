set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
# Phase f: the HiRAM stall enable (cpu_rdy, containing ext_ram_sdram state==S_DONE) is a
# synchronous clock-ENABLE, but gated-clock-conversion was turning it into a derived GATED
# CLOCK on a global net (the unconstrained clock "emu|...|state.S_DONE").  That leaves the
# CPU stall/enable path UNTIMED -> CPU mis-reads SDRAM HiRAM -> RAM detect fails ("8K") and
# keyboard dies + flaky boot, even though the SDRAM self-test (which bypasses cpu_rdy) is
# rock solid.  Disable the conversion so the enable stays normal cpu_clk-domain logic.
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION OFF
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT LOW
set_global_assignment -name SEED 3

# Phase f: the HiRAM stall enable (ext_ram_sdram FSM S_DONE -> ready -> cpu_rdy ->
# CPU rdy_i + VIA enable) is a high-fanout SYNCHRONOUS ENABLE, NOT a clock.  Quartus
# ONE-HOT encodes the FSM, so S_DONE is a single clean flip-flop; gated-clock-conversion
# then treats that FF (driving the enable) as a clock -> "unconstrained clock".  Force
# USER-ENCODED (binary) on this FSM so `state==S_DONE` is a multi-bit DECODE (like the
# VERA `vera_read_stall>=2` stall, which is never flagged), not a single FF clock root.
set_instance_assignment -name STATE_MACHINE_PROCESSING "USER-ENCODED" -to "emu:emu|ext_ram_sdram:u_hiram"
# (a GLOBAL_SIGNAL OFF on ...|state.S_DONE used to live here; USER-ENCODED renamed the
#  FSM bits so that node no longer exists -- the dead target only produced an
#  "ignored assignment" fitter warning.  Removed.)

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
